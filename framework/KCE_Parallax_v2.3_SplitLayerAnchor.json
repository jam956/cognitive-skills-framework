{
  "module_name": "Key Concept Extraction Parallax Engine",
  "short_name": "KCE_Parallax",
  "version": "v2.3.0",
  "status": "conceptual_executable_spec",
  "revision_kind": "split_ontology_dynamical_core_regime_anchor_extraction_upgrade",
  "supersedes": "KCE_Parallax_v2.2_ProvisionalAnchor",
  "purpose": "Extract provisional, inspectable anchors from natural language prompts while explicitly separating ontology candidates, dynamical core candidates, regime field candidates, actor-role candidates, computed behavior labels, and transform seeds. KCE v2.3 prevents premature invariant lock-in, operator-regime conflation, and composite-label collapse before downstream CDP, Dynamical Prism v0.2, Regime Field v0.1, Coupler v1.5, CTR v2.1, CREM v1.3, ETE, PSPP, CEC, and DARE processing.",
  "core_doctrine": [
    "Extract anchors, but do not trust them yet.",
    "Compress structure, but report what compression may have destroyed.",
    "Emit anchor candidates rather than a single final anchor unless confidence is high and risk is low.",
    "Separate ontology, dynamical core, regime field, actor role, and computed label candidates.",
    "Do not treat computed behavior labels as primitive operators.",
    "Do not treat regime conditions as primitive operators.",
    "Do not treat ontology axes as dynamical causes unless the Coupler validates the binding.",
    "Preserve anomaly markers that might be erased by compression.",
    "Emit memory candidates, not durable memory writes.",
    "Expose uncertainty, suspected operator gaps, regime gaps, and label-collapse risks for DARE/IDCM review."
  ],
  "registry_refs": {
    "CDP": "CDP_Parallax_v1.2_BoundedDomainSpace.json",
    "OntologicPrism": "19D_Ontologic_Prism",
    "DynamicalPrism": "Dynamical_Prism_v1.2_ReducedCore.json",
    "RegimeField": "Regime_Field_v0.1.json",
    "PrismCoupler": "Prism_Coupler_v1.5_OntologyDynamicsRegime.json",
    "CTR": "CTR_Parallax_v2.1_SplitTransformRegistry.json",
    "ETE": "ETE_v1.1_SplitLayerExplorationTransform.json",
    "CREM": "CREM_v1.3_SplitOntologyDynamicsRegime.json",
    "ECE": "ECE_v0.3_optional_affect_reward_regulation",
    "PSPP_Lite": "PSPP_v5.0_CandidateSystemComparator.json",
    "CEC": "CEC_Parallax_v1.1_ConditionalPathValidator.json",
    "DARE_IDCM": "DARE_IDCM_v1.0_ParallelSupervisoryLayer.json"
  },
  "responsibility_boundary": {
    "owns": [
      "surface_parse",
      "alias_guard",
      "anomaly_marker_extraction",
      "structural_reduction",
      "relation_extraction",
      "role_function_abstraction",
      "ontology_candidate_seed",
      "dynamical_core_candidate_seed",
      "regime_field_candidate_seed",
      "computed_label_candidate_seed",
      "actor_role_candidate_seed",
      "abstraction_ladder_probe",
      "anchor_candidate_generation",
      "invariant_compression_variants",
      "compression_risk_scoring",
      "operator_regime_conflation_detection",
      "computed_label_collapse_detection",
      "regime_gap_detection",
      "polarity_dualization",
      "axis_binding",
      "phase_align_axes",
      "transform_seed_binding",
      "ECE_affect_hint_emit",
      "DARE_signal_emit",
      "provisional_memory_candidate_emit"
    ],
    "does_not_own": [
      "final_anchor_locking",
      "durable_memory_write_execution",
      "domain_axis_selection_final",
      "primitive_dynamical_operator_definition",
      "regime_axis_definition",
      "actor_role_binding_final",
      "transform_selection_final",
      "branch_competition",
      "adversarial_verification",
      "final_answer_synthesis",
      "external_fact_verification"
    ],
    "handoff_note": "KCE v2.3 emits provisional anchor packets and split-layer seed candidates. Downstream engines may use selected_working_anchor for efficiency, but lock_status must remain provisional or contested until validated by PSPP, DARE/IDCM, CEC, CREM, or the Arbiter."
  },
  "placement": {
    "pipeline_stage": "pre_domain_split_anchor_extraction",
    "runs_after": [
      "raw_prompt_intake",
      "retrieval_or_file_ingest_when_applicable"
    ],
    "runs_before": [
      "CDP_Parallax_v1.2",
      "Dynamical_Prism_v0.2",
      "Regime_Field_v0.1",
      "Prism_Coupler_v1.5",
      "CTR_v2.1",
      "ETE",
      "CREM_v1.3",
      "ECE_v0.3",
      "PSPP_Lite",
      "CEC",
      "DARE_IDCM",
      "Arbiter"
    ],
    "recommended_mode": "loose_split_anchor_mode_by_default"
  },
  "inputs": {
    "prompt_text": {
      "type": "string",
      "description": "Raw natural language prompt, statement, task, observation, or dialogue excerpt."
    },
    "retrieved_context": {
      "type": "array",
      "required": false,
      "description": "Optional retrieved/file context, if present."
    },
    "conversation_context": {
      "type": "object",
      "required": false,
      "description": "Relevant continuity, user preference, or project-state context."
    },
    "context": {
      "type": "object",
      "required": false,
      "properties": {
        "domain_hint": {
          "type": "array",
          "items": "string",
          "description": "Soft hints only; should not force anchor locking."
        },
        "depth_level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3,
          "default": 2
        },
        "compression_target": {
          "type": "string",
          "enum": [
            "minimal",
            "balanced",
            "diagnostic",
            "loose"
          ],
          "default": "loose"
        },
        "anchor_mode": {
          "type": "string",
          "enum": [
            "loose",
            "balanced",
            "lock_if_safe"
          ],
          "default": "loose"
        },
        "emit_embedding": {
          "type": "boolean",
          "default": false
        },
        "emit_axes": {
          "type": "boolean",
          "default": true
        },
        "emit_trace": {
          "type": "boolean",
          "default": true
        },
        "emit_transform_plan": {
          "type": "boolean",
          "default": true
        },
        "dare_watch": {
          "type": "boolean",
          "default": true
        },
        "ece_watch": {
          "type": "boolean",
          "default": true
        },
        "memory_write_policy": {
          "type": "string",
          "enum": [
            "provisional_only",
            "allow_validated_write"
          ],
          "default": "provisional_only"
        }
      }
    }
  },
  "outputs": {
    "kce_packet": {
      "type": "object",
      "description": "Primary v2.3 packet containing anchor candidates, split-layer seeds, compression telemetry, transform seeds, ECE hints, DARE signals, and memory candidates."
    },
    "trace": {
      "type": "object",
      "description": "Optional derivation trace for audit, debugging, refinement, and DARE inspection."
    }
  },
  "split_layer_seed_model": {
