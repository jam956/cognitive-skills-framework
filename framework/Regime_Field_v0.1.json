  "operator_regime_mismatch_rules": [
    {
      "id": "ORM_001",
      "pattern": "stabilize_under_growth_regime",
      "risk": "stagnation_or_suppression",
      "diagnostic_question": "Is stabilization preserving viability or preventing necessary expansion?"
    },
    {
      "id": "ORM_002",
      "pattern": "explore_under_emergency_regime",
      "risk": "dangerous_delay",
      "diagnostic_question": "Is more search useful, or is immediate execution required?"
    },
    {
      "id": "ORM_003",
      "pattern": "constrain_under_trust_repair_regime",
      "risk": "domination_disguised_as_repair",
      "diagnostic_question": "Does the constraint protect boundaries or erase agency?"
    },
    {
      "id": "ORM_004",
      "pattern": "signal_under_high_noise_regime",
      "risk": "distortion_or_misinterpretation",
      "diagnostic_question": "Should the system improve channel quality before increasing signal volume?"
    },
    {
      "id": "ORM_005",
      "pattern": "coordinate_under_low_trust_regime",
      "risk": "false_alignment_or_compliance_theater",
      "diagnostic_question": "Is coordination real or merely formal compliance?"
    },
    {
      "id": "ORM_006",
      "pattern": "select_under_high_uncertainty_regime",
      "risk": "premature_collapse",
      "diagnostic_question": "Has the system gathered enough discriminating evidence to choose?"
    },
    {
      "id": "ORM_007",
      "pattern": "adapt_under_high_irreversibility_regime",
      "risk": "maladaptive_lock_in",
      "diagnostic_question": "Will adaptation become locked before feedback can validate it?"
    }
  ],
