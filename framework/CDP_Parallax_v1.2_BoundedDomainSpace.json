    "overbreadth_guard": "suppress_axes_that_add_language_but_not_decision_power",
    "underbreadth_guard": "reactivate_suppressed_axis_if_DARE_or_residual_error_flags_domain_lock",
    "full_19d_allowed_only_if": [
      "user_explicitly_requests_full_prism",
      "depth_level == 3",
      "contradiction_or_novelty_pressure_high",
      "allow_full_19d == true"
    ],
    "axis_materiality_tests": [
      "Does this domain change candidate branch generation?",
      "Does this domain expose a constraint, falsifier, or missing variable?",
      "Does this domain alter actor-role/dynamical binding downstream?",
      "Does this domain reduce uncertainty among anchor candidates?",
      "Does this domain preserve anomaly markers that KCE warned might be lost?"
    ]
  },
