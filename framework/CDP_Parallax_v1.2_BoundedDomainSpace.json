{
  "module_name": "Cognitive Domain Prism",
  "short_name": "CDP_Parallax",
  "version": "v1.2.0",
  "status": "design_stable_executable_spec",
  "revision_kind": "efficiency_and_space_definition_upgrade",
  "supersedes": "CognitiveDomainPrism_Parallax_v1.json",
  "generated_utc": "2026-05-02T19:12:25.818982+00:00",
  "purpose": "Provide a bounded 19-domain coordinate layer for selecting, weighting, and auditing the domain space in which reasoning should operate. This version preserves the original 19D prism but tightens activation, reduces over-breadth, consumes KCE v2.3 split-layer anchor candidates, emits candidate-specific prism profiles, and exports DARE-visible breadth, collision, and domain-lock signals.",
  "core_doctrine": [
    "CDP defines where reasoning should search; it does not decide the final answer.",
    "Activate only domains that materially change the analysis.",
    "Prefer a small, high-signal active domain set over full 19D activation.",
    "When KCE emits multiple anchor candidates, CDP should map each candidate separately before collapsing domain space.",
    "Do not overfit domain selection to a single clean anchor when KCE marks the anchor as provisional or contested.",
    "Domain breadth should be budgeted globally and reallocated only when novelty, contradiction, or DARE signals justify it."
  ],
  "responsibility_boundary": {
    "owns": [
      "domain_axis_selection",
      "subdomain_selection",
      "bounded_energy_allocation",
      "domain_collision_detection",
      "anchor_candidate_domain_mapping",
      "domain_breadth_budgeting",
      "domain_lock_risk_detection",
      "domain_profile_deduplication",
      "DARE_domain_signal_emit"
    ],
    "does_not_own": [
      "anchor_extraction",
      "primitive_dynamical_operator_definition",
      "actor_role_binding",
      "transform_geometry",
      "branch_scoring",
      "candidate_system_competition",
      "final_answer_synthesis",
      "persona_control"
    ],
    "handoff_note": "CDP v1.2 emits prism profiles, not conclusions. For legacy modules expecting a single prism_profile, the selected_working_profile may be used as a provisional compatibility profile."
  },
  "intended_runtime": "Space-definition layer after KCE and before Dynamical Prism, Coupler, ETE, PSPP, CREM, CEC, DARE/IDCM, and final Arbiter.",
  "placement": {
    "pipeline_stage": "domain_space_definition",
    "runs_after": [
