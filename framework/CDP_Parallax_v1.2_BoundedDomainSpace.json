      "minimum_active_axis_weight": 0.03,
      "watch_axis_weight": 0.01
    },
    "reallocation_policy": {
      "from_low_entropy_channels": true,
      "to_high_decision_power_axes": true,
      "protect_kce_anomaly_axes": true,
      "avoid_duplicate_domain_profiles": true
    }
  },
  "stage_order": [
    "ingest_kce_packet",
    "anchor_candidate_domain_mapping",
    "domain_prior_scoring",
    "axis_materiality_filter",
    "subdomain_selection",
    "energy_allocation",
    "collision_and_alias_scan",
    "domain_profile_deduplication",
    "domain_lock_risk_detection",
    "selected_working_profile_emit",
    "DARE_domain_signal_emit"
  ],
  "stages": {
    "ingest_kce_packet": {
      "description": "Read KCE anchor candidates, selected_working_anchor, abstraction ladder, compression telemetry, and DARE signals.",
      "outputs": [
        "anchor_candidate_refs",
        "kce_risk_summary",
        "kce_anomaly_markers",
        "kce_abstraction_level"
      ]
    },
    "anchor_candidate_domain_mapping": {
      "description": "Map each material KCE anchor candidate into a candidate-specific domain profile before selecting a working profile.",
      "policy": {
        "map_top_n_anchor_candidates": 3,
        "always_map_contested_anchor": true,
        "always_map_anomaly_preserving_anchor": true
      },
      "outputs": [
        "candidate_prism_profiles"
      ]
    },
    "domain_prior_scoring": {
      "description": "Score domain axes using anchor axes, prompt cues, domain hints, anomaly markers, abstraction level, and likely downstream decision power.",
      "scoring_dimensions": {
        "anchor_axis_fit": 0.22,
        "prompt_entity_fit": 0.12,
        "relation_pattern_fit": 0.14,
        "anomaly_preservation": 0.14,
        "downstream_decision_power": 0.16,
        "user_context_fit": 0.08,
        "novelty_or_escape_value": 0.08,
        "cost_penalty": 0.06
      },
      "outputs": [
        "domain_scores"
      ]
    },
    "axis_materiality_filter": {
      "description": "Select active axes only when they materially change analysis or preserve a KCE-flagged anomaly.",
      "rules": [
        "keep_axis_if_score_above_activation_threshold",
        "keep_axis_if_required_by_contested_anchor",
        "keep_axis_if_required_by_anomaly_marker",
        "drop_axis_if_only_decorative_or_style_echo",
        "mark_suppressed_axis_as_watch_axis_if_possible_future_relevance"
      ],
      "thresholds": {
        "activation_threshold": 0.42,
        "watch_threshold": 0.25,
        "decorative_axis_penalty": 0.15
      },
      "outputs": [
        "active_axes",
        "watch_axes",
        "suppressed_axes"
      ]
    },
    "subdomain_selection": {
      "description": "Select bounded subdomains within each active axis.",
      "policy": {
        "max_subdomains_per_axis_default": 3,
        "max_subdomains_per_axis_depth_3": 5,
        "prefer_subdomains_that_map_to_KCE_relations": true,
        "avoid_subdomain_sprawl": true
      },
      "outputs": [
        "active_subdomains"
      ]
    },
    "energy_allocation": {
      "description": "Allocate normalized energy across active axes under global caps.",
      "outputs": [
        "energy_alloc",
        "energy_rationale"
      ]
    },
    "collision_and_alias_scan": {
      "description": "Detect domain collisions, metaphor alias risks, false equivalence, and teleological overreach.",
      "detectors": [
        {
          "name": "semantic_coalescer",
          "threshold": 0.15,
          "action": "split_and_rephase"
        },
        {
          "name": "teleology_brake",
          "threshold": 0.18,
          "action": "restore_causality"
        },
        {
          "name": "domain_alias_collision",
          "threshold": 0.2,
          "action": "protect_distinct_domain_roles"
        },
        {
          "name": "style_bleed_detector",
          "threshold": 0.18,
          "action": "separate_aesthetic_language_from_structural_role"
        }
      ],
      "outputs": [
        "collision_risks",
        "collision_actions"
      ]
    },
    "domain_profile_deduplication": {
      "description": "Merge or suppress candidate prism profiles that are structurally duplicate despite different labels.",
      "rules": [
        "compare_active_axis_overlap",
        "compare_subdomain_overlap",
        "compare_downstream_decision_power",
        "preserve_duplicate_only_if_it_maps_to_different_KCE_anchor_risk"
      ],
      "outputs": [
        "deduped_candidate_prism_profiles"
      ]
    },
    "domain_lock_risk_detection": {
      "description": "Detect whether CDP is overcommitting to a native or familiar domain set.",
      "signals": [
        "one_domain_dominates_energy_too_early",
        "KCE_anchor_contested_but_domain_profile_single",
        "high_anomaly_salience_but_low_domain_diversity",
        "suppressed_axes_include_high_novelty_value",
        "watch_axes_repeat_across_failed_runs"
      ],
      "outputs": [
        "domain_lock_report"
      ]
    },
    "selected_working_profile_emit": {
      "description": "Emit one provisional selected profile for legacy compatibility while preserving alternatives.",
      "outputs": [
        "selected_working_profile",
        "candidate_prism_profiles"
      ]
    },
    "DARE_domain_signal_emit": {
      "description": "Emit DARE/IDCM-visible signals about overbreadth, underbreadth, collision, domain-lock, and missing-domain risks.",
      "outputs": [
        "dare_domain_signals"
      ]
    }
  },
  "output_schema": {
    "cdp_packet": {
      "schema_version": "cdp.parallax/1.2",
      "source": {
