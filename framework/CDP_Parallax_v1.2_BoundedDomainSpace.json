          "watch_axes": "array"
        },
        "to_coupler": {
          "active_axes": "array",
          "active_subdomains": "object",
          "domain_role_hints": "array"
        },
        "to_ETE": {
          "candidate_prism_profiles": "array",
          "watch_axes": "array",
          "domain_lock_report": "object"
        },
        "to_PSPP": {
          "selected_working_profile": "object",
          "alternate_profiles": "array",
          "avoid_duplicate_domain_profiles": true
        },
        "to_DARE": {
          "dare_domain_signals": "object",
          "domain_lock_report": "object",
          "collision_report": "object"
        }
      },
      "trace": {
        "operators_used": "array",
        "decision_notes": "array",
        "risk_notes": "array"
      }
    }
  },
  "routing_policy": {
    "default": "bounded_candidate_profile_mode",
    "rules": [
      {
        "condition": "KCE.selected_working_anchor.lock_status == 'provisional' AND KCE.dare_signals.anchor_suspicion < 0.45",
        "action": "map_primary_anchor_and_top_alternate_if_material"
      },
      {
        "condition": "KCE.selected_working_anchor.lock_status == 'contested' OR KCE.dare_signals.anchor_suspicion >= 0.60",
        "action": "map_multiple_anchor_candidates_and_emit_DARE_domain_review"
      },
      {
        "condition": "active_axis_count > soft_cap",
        "action": "tighten_axes_by_decision_power"
      },
      {
        "condition": "domain_lock_suspicion >= 0.60",
        "action": "spawn_alternate_profile_or_DARE_review"
      },
      {
        "condition": "collision_suspicion >= 0.55",
        "action": "split_and_rephase_colliding_axes"
      },
      {
        "condition": "underbreadth_suspicion >= 0.55 AND contradiction_or_anomaly_persists",
        "action": "promote_watch_axis_to_active_axis"
      }
    ]
  },
  "guards": {
    "anti_overbreadth": {
      "soft_cap_axes": 9,
      "default_max_axes": 7,
      "suppress_decorative_axes": true,
      "prefer_decision_power_over_domain_coverage": true
    },
    "anti_underbreadth": {
      "watch_axes_enabled": true,
      "preserve_kce_anomaly_axes_as_watch_or_active": true,
      "domain_lock_detection_required": true
    },
    "anti_domain_alias_collapse": {
      "metaphor_alias_guard": true,
      "split_domains_when_same_token_has_different_function": true,
      "style_axis_separated_from_structural_axes": true
    },
    "anti_recomputation": {
      "emit_profile_ids_for_reuse": true,
      "deduplicate_domain_profiles": true,
      "do_not_rerun_domain_mapping_unless_anchor_or_DARE_signals_change": true
    },
    "anti_memory_contamination": {
      "CDP_does_not_write_memory": true,
      "emit_memory_relevance_only_as_trace": true
    }
  },
  "scoring": {
    "domain_score": {
      "anchor_axis_fit": 0.22,
      "prompt_entity_fit": 0.12,
      "relation_pattern_fit": 0.14,
      "anomaly_preservation": 0.14,
      "downstream_decision_power": 0.16,
      "user_context_fit": 0.08,
      "novelty_or_escape_value": 0.08,
      "cost_penalty": -0.06
    },
    "profile_confidence": {
      "active_axis_fit": 0.25,
      "subdomain_specificity": 0.15,
      "collision_low": 0.15,
      "decision_power": 0.2,
      "KCE_anchor_compatibility": 0.15,
      "cost_economy": 0.1
    },
    "domain_lock_suspicion": {
      "single_axis_dominance": 0.25,
      "low_domain_diversity_under_high_anomaly": 0.2,
      "contested_anchor_single_profile": 0.2,
      "suppressed_high_novelty_axes": 0.15,
      "repeated_watch_axis_rescue": 0.1,
      "style_or_native_domain_overfit": 0.1
    }
  },
  "canonical_packet_compatibility": {
    "legacy_fields_provided": [
      "prism_profile"
    ],
    "legacy_field_mapping": {
      "prism_profile.active_axes": "selected_working_profile.active_axes",
      "prism_profile.active_subdomains": "selected_working_profile.active_subdomains",
      "prism_profile.energy_alloc": "selected_working_profile.energy_alloc",
      "prism_profile.collision_risks": "selected_working_profile.collision_risks",
      "prism_profile.prism_rationale": "selected_working_profile.prism_rationale"
    },
    "compatibility_note": "For older modules expecting a single prism_profile, selected_working_profile may be used provisionally. Modules should preserve alternate_profiles when KCE or CDP lock_status is contested."
  },
