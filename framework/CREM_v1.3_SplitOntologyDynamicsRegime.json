{
  "module_name": "Conflict and Relationship Rebase Module",
  "short_name": "CREM",
  "version": "v1.3.0",
  "status": "conceptual_executable_spec",
  "revision_kind": "split_ontology_dynamical_core_regime_rebase_upgrade",
  "supersedes": "CREM_v1.2_NPartyRelationshipRebase",
  "purpose": "Rebase relationships among two or more coherent parties, perspectives, agents, systems, or candidate branches using the split Prism architecture: 19D Ontologic Prism, Dynamical Core v0.2, Regime Field v0.1, and Prism Coupler v1.5. CREM v1.3 separates operator conflict from regime conflict, operator alignment from regime alignment, and composite behavior labels from primitive explanatory structure.",
  "core_statement": "When multiple coherent perspectives interact, do not merely choose, average, or compromise. Factor each party into ontology, actor role, dynamical core vector, regime field, and computed behavior labels. Determine whether conflict or alignment arises from primitive operator structure, regime constraints, shared dependencies, or mislabeled composites. Rebase around the appropriate invariant while preserving party distinction and necessary dependencies.",
  "core_doctrine": [
    "CREM supports n-party systems, not only dyads.",
    "Conflict rebase and alignment rebase remain sibling modes.",
    "Operator conflict and regime conflict must be separated.",
    "Operator alignment and regime alignment must be separated.",
    "Many apparent dynamical conflicts are actually same-operator/different-regime conflicts.",
    "Many apparent compromises erase party distinction by hiding regime asymmetry.",
    "Computed labels such as control, governance, healing, conflict, growth, collapse, or cooperation are not primitive rebase centers unless decomposed.",
    "Aligned dynamicals must be structural, not merely agreeable language.",
    "Relationship strengthening requires preserving party distinction while improving compatible coordination.",
    "Preserve productive tension when tension carries necessary information.",
    "Emit PSPP-ready candidate systems and DARE-auditable decision artifacts."
  ],
  "registry_refs": {
    "KCE": "KCE_Parallax_v2.3_SplitLayerAnchor.json",
    "CDP": "CDP_Parallax_v1.2_BoundedDomainSpace.json",
    "OntologicPrism": "19D_Ontologic_Prism",
    "DynamicalPrism": "Dynamical_Prism_v1.2_ReducedCore.json",
    "RegimeField": "Regime_Field_v0.1.json",
    "PrismCoupler": "Prism_Coupler_v1.5_OntologyDynamicsRegime.json",
    "CTR": "CTR_Parallax_v2.1_SplitTransformRegistry.json",
    "ETE": "ETE_v1.1_SplitLayerExplorationTransform.json",
    "PSPP_Lite": "PSPP_v5.0_CandidateSystemComparator.json",
    "CEC": "CEC_Parallax_v1.1_ConditionalPathValidator.json",
    "DARE_IDCM": "DARE_IDCM_v1.0_ParallelSupervisoryLayer.json"
  },
  "responsibility_boundary": {
    "owns": [
      "n_party_frame_normalization",
      "party_anchor_mapping",
      "party_ontology_mapping",
      "party_dynamical_core_mapping",
      "party_regime_field_mapping",
      "party_coupling_mapping",
      "operator_conflict_alignment_partition",
      "regime_conflict_alignment_partition",
      "same_operator_different_regime_detection",
      "different_operator_same_regime_detection",
      "computed_label_decomposition",
      "shared_dependency_invariant_extraction",
      "operator_conflict_invariant_extraction",
      "regime_conflict_invariant_extraction",
      "operator_alignment_invariant_extraction",
      "regime_alignment_invariant_extraction",
      "mixed_rebase_center_selection",
      "party_integrity_preservation_gate",
      "false_harmony_gate",
      "forced_alignment_gate",
      "relationship_rebase_plan_generation",
      "candidate_system_branch_emission",
      "rebase_vector_emission",
      "DARE_audit_artifact_emit"
    ],
    "does_not_own": [
      "primitive_domain_axis_definition",
      "primitive_dynamical_operator_definition",
      "regime_axis_definition",
      "primary_anchor_extraction",
      "general_transform_execution",
      "candidate_system_competition",
      "ordered_path_validation_execution",
      "final_answer_synthesis",
      "external_fact_verification",
      "durable_memory_write_execution"
    ],
    "handoff_note": "CREM v1.3 emits rebase packets, operator/regime invariants, dependency invariants, latent axes, relationship-strengthening plans, and PSPP-ready candidate systems. PSPP-lite compares candidate systems; CEC validates ordered paths; DARE audits pruning, false harmony, operator-regime conflation, and party-erasure risks."
  },
  "activation_policy": {
    "invoke_when": [
      "two_or_more_coherent_perspectives_conflict",
      "three_or_more_parties_or_branches_interact",
      "opposition_and_alignment_are_both_present",
      "argument_looping_or_repeating_known_positions",
      "same_operator_different_regime_suspected",
      "different_operator_same_regime_suspected",
      "operator_regime_conflation_suspected",
      "computed_label_conflict_suspected",
      "shared_dependencies_visible_or_suspected",
      "relationship_strengthening_requested",
      "trust_repair_or_coalition_formation_requested",
      "common_ground_requested_without_erasing_differences",
      "PSPP_Lite_detects_multiple_coherent_candidate_systems_with_alignment_or_conflict",
      "Coupler_v1_5_emits_CREM_first_or_parallel_CREM_ETE_route"
    ],
    "do_not_invoke_when": [
      "single_party_problem_without_material_conflict_or_relationship_goal",
      "simple_fact_retrieval",
      "pure_summarization_without_party_dynamics",
      "conflict_is_trivial_or_semantic_only",
      "one_party_frame_is_incoherent_and_needs_basic_correction_first",
      "relationship_strengthening_request_has_no_identifiable_parties"
    ],
    "mode_selection": {
      "operator_conflict_rebase": [
        "operator_conflict_score >= 0.35",
        "opposition_factors_material",
        "regime_conflict_score < operator_conflict_score"
      ],
      "regime_conflict_rebase": [
        "regime_conflict_score >= 0.35",
        "same_operator_different_regime_present",
        "regime_conflict_score >= operator_conflict_score"
      ],
      "operator_alignment_rebase": [
        "operator_alignment_score >= 0.35",
        "relationship_strengthening_intent_present",
        "shared_or_complementary_core_operators_present"
      ],
      "regime_alignment_rebase": [
        "regime_alignment_score >= 0.35",
        "shared_regime_conditions_can_support_coordination",
        "party_distinction_preserved"
      ],
      "mixed_rebase": [
        "operator_conflict_score >= 0.30",
        "regime_conflict_score >= 0.30",
        "alignment_score >= 0.25",
        "n_party_system_contains_coalitions_or_subgroups"
      ],
      "productive_tension_preservation": [
        "conflict_contains_valid_dependency_information",
        "resolution_would_erase_party_integrity_or_falsifier_value"
      ]
    }
  },
  "inputs": {
    "prompt_text": {
      "type": "string",
      "description": "Raw prompt, discourse excerpt, debate, relationship request, article/rebuttal set, or multi-branch candidate system statement."
    },
    "party_frames": {
      "type": "array",
      "required": false,
      "description": "Party-specific perspectives, claims, goals, values, fears, incentives, or relationship goals.",
      "items_template": {
        "party_id": "string",
        "party_label": "string",
        "party_type": "person|group|institution|agent|system|branch|role|perspective",
        "claims": [],
        "evidence": [],
        "stated_goal": "string_or_null",
        "protected_values": [],
        "relationship_goal": "string_or_null",
        "context": {}
      }
    },
    "coupler_packet_v1_5": {
      "type": "object",
      "required": false,
      "description": "Preferred input: Prism Coupler v1.5 packet with party_actor_bindings, ontology/dynamical/regime bindings, operator/regime relationship maps, and DARE signals."
    },
    "candidate_system_branches": {
      "type": "array",
      "required": false,
      "description": "PSPP-lite or ETE branches that can be treated as parties/perspectives for conflict or alignment rebase."
    },
    "optional_upstream_packets": {
