  ],
  "stages": {
    "intake_and_party_frame_normalization": {
      "purpose": "Normalize parties, perspectives, agents, systems, or candidate branches without prematurely judging which is correct.",
      "outputs": [
        "party_frames_normalized",
        "opening_conflict_lock",
        "relationship_goal_lock"
      ]
    },
    "mode_selection": {
      "purpose": "Select operator_conflict, regime_conflict, operator_alignment, regime_alignment, mixed, or productive_tension mode.",
      "outputs": [
        "selected_mode",
        "mode_rationale"
      ]
    },
    "party_anchor_mapping": {
      "purpose": "Run lightweight KCE-style anchor mapping per party, preserving party-specific values and relationship goals.",
      "outputs": [
        "party_anchor_packets"
      ]
    },
    "party_ontology_mapping": {
      "purpose": "Map each party's 19D ontology profile independently.",
      "outputs": [
        "party_ontology_profiles",
        "domain_overlap",
        "domain_collision_risks"
      ]
    },
    "party_dynamical_core_mapping": {
      "purpose": "Map each party's reduced core operator vector independently.",
      "outputs": [
        "party_dynamical_core_profiles",
        "operator_conflicts",
        "operator_alignments",
        "operator_complementarities"
      ]
    },
    "party_regime_field_mapping": {
      "purpose": "Map each party's regime field independently, including asymmetries and shared regime constraints.",
      "outputs": [
        "party_regime_profiles",
        "regime_conflicts",
        "regime_alignments",
        "regime_asymmetries"
      ]
    },
    "party_coupling_ingest_or_reconstruction": {
      "purpose": "Consume Coupler v1.5 packets when available or reconstruct minimal couplings from ontology/core/regime inputs.",
      "outputs": [
        "party_coupling_packets",
        "coupling_instabilities"
      ]
    },
    "computed_label_decomposition": {
      "purpose": "Decompose labels such as control, healing, growth, collapse, conflict, or governance into supporting operators and regimes.",
      "outputs": [
        "label_decomposition_packets",
        "label_collapse_risks"
      ]
    },
    "party_graph_construction": {
      "purpose": "Construct dyadic and hyperedge graph over all parties, including separate operator and regime relationship layers.",
      "outputs": [
        "party_graph"
      ]
    },
    "factor_hypergraph_extraction": {
      "purpose": "Extract compact factors from party anchors, ontologies, core dynamics, regimes, couplings, and party graph.",
      "factor_types": [
        "ontological_factor",
        "operator_factor",
        "regime_factor",
        "computed_label_factor",
        "role_factor",
        "dependency_factor",
        "constraint_factor",
        "cost_factor",
        "risk_factor",
        "legitimacy_factor",
        "trust_factor",
        "coordination_factor",
        "repair_factor",
        "shared_goal_factor",
        "complementarity_factor"
      ],
      "outputs": [
        "factor_hypergraph"
      ]
    },
    "operator_opposition_alignment_partition": {
      "purpose": "Partition operator factors into opposition, alignment, complementarity, dependency, and neutral sets.",
      "outputs": [
        "operator_opposition_pairs",
        "operator_alignment_sets",
        "operator_complementarity_sets"
      ]
    },
    "regime_opposition_alignment_partition": {
      "purpose": "Partition regime factors into opposition, alignment, asymmetry, dependency, and neutral sets.",
      "outputs": [
        "regime_opposition_pairs",
        "regime_alignment_sets",
        "regime_asymmetry_sets"
      ]
    },
    "same_operator_different_regime_detection": {
      "purpose": "Detect parties sharing core operators while diverging because of different regime fields.",
      "outputs": [
        "same_operator_different_regime_pairs"
      ]
    },
    "different_operator_same_regime_detection": {
      "purpose": "Detect parties using different operators under the same regime, often indicating complementarity.",
      "outputs": [
        "different_operator_same_regime_pairs"
      ]
    },
    "dependency_invariant_extraction": {
      "purpose": "Extract invariants from dependencies required for the system or relationship to function.",
      "outputs": [
        "dependency_invariants"
      ]
    },
    "operator_conflict_invariant_extraction_if_needed": {
      "purpose": "Extract the operator-level invariant that generates observed opposition.",
      "outputs": [
        "candidate_operator_conflict_invariants"
      ]
    },
    "regime_conflict_invariant_extraction_if_needed": {
      "purpose": "Extract the regime-level invariant that generates observed opposition.",
      "outputs": [
        "candidate_regime_conflict_invariants"
      ]
    },
    "operator_alignment_invariant_extraction_if_needed": {
      "purpose": "Extract shared or complementary core operators that can strengthen coordination.",
      "outputs": [
        "candidate_operator_alignment_invariants"
      ]
    },
    "regime_alignment_invariant_extraction_if_needed": {
      "purpose": "Extract shared or compatible regime conditions that can strengthen relationship without erasing differences.",
      "outputs": [
        "candidate_regime_alignment_invariants"
      ]
    },
    "conflict_generation_gate_if_conflict_mode": {
      "purpose": "Require the conflict invariant to reproduce and explain the original conflict.",
      "outputs": [
        "validated_conflict_invariants",
        "conflict_generation_report"
      ]
    },
    "alignment_preservation_gate_if_alignment_mode": {
      "purpose": "Require the alignment invariant to preserve party distinction and explain actual compatibility.",
      "outputs": [
        "validated_alignment_invariants",
        "alignment_preservation_report"
      ]
    },
    "relationship_strengthening_gate_if_relationship_goal": {
      "purpose": "Require strengthening plans to improve trust, coordination, or shared purpose while preserving party integrity.",
      "outputs": [
        "relationship_strengthening_report"
      ]
    },
    "false_harmony_and_forced_alignment_gate": {
      "purpose": "Reject or flag rebases that create surface agreement by erasing trust deficits, regime asymmetry, or party distinction.",
      "outputs": [
        "false_harmony_report",
        "forced_alignment_report",
        "party_erasure_report"
      ]
    },
    "rebase_center_selection": {
      "purpose": "Select the appropriate rebase center: operator invariant, regime invariant, shared dependency, complementarity, or productive tension.",
      "outputs": [
        "validated_rebase_invariant",
        "rebase_center_rationale"
      ]
    },
    "latent_axis_ranking": {
      "purpose": "Rank latent axes that explain persistent conflict or alignment not captured by surface factors.",
      "outputs": [
        "ranked_latent_axes"
      ]
    },
    "dependency_constrained_rotation": {
      "purpose": "Rotate or reframe using dependency invariants as constraints so novelty does not erase system requirements.",
      "outputs": [
        "dependency_constrained_views"
      ]
    },
    "relationship_rebase_plan_generation": {
      "purpose": "Generate practical or conceptual plans for conflict resolution, relationship strengthening, coalition, repair, or productive tension preservation.",
      "outputs": [
        "relationship_rebase_plan"
      ]
    },
    "candidate_system_branch_emission": {
      "purpose": "Emit PSPP-ready candidate systems.",
      "outputs": [
        "candidate_system_branches"
      ]
    },
    "dependency_preservation_gate": {
      "purpose": "Ensure emitted branches preserve necessary dependencies.",
      "outputs": [
        "dependency_preservation_report"
      ]
    },
    "tradeoff_surface_extraction_optional": {
      "purpose": "Extract tradeoffs among parties, operators, regimes, values, and costs when relevant.",
      "outputs": [
        "tradeoff_surface"
      ]
    },
    "memory_rebase_vector_emit": {
      "purpose": "Emit optional memory-worthy rebase vectors without executing durable memory writes.",
      "outputs": [
        "memory_rebase_vector_candidates"
      ]
    },
    "telemetry_emit": {
      "purpose": "Emit audit metrics for branch selection, false harmony risk, regime conflict, and novelty.",
      "outputs": [
        "telemetry"
      ]
    }
  },
  "gates": {
    "conflict_generation_gate": {
      "questions": [
        "Does this invariant explain why the opening conflict exists?",
        "If this invariant is removed, does the original conflict disappear or become unintelligible?",
        "Does it preserve the subject rather than replacing it?"
      ],
      "pass_condition": "candidate_conflict_generation_score >= 0.62 AND return_path_to_opening_conflict_present == true"
    },
    "alignment_preservation_gate": {
      "questions": [
        "Does this invariant explain why relationship strengthening is possible?",
        "Does it preserve party distinction rather than flattening differences?",
        "Does it identify shared or complementary operators/regimes rather than vague common ground?",
        "Would strengthening this invariant improve trust, coordination, or shared action?"
      ],
      "pass_condition": "candidate_alignment_score >= 0.62 AND party_distinction_preserved == true"
    },
    "false_harmony_gate": {
      "questions": [
        "Is agreement produced by coercion, avoidance, low-trust compliance, or party erasure?",
        "Does the plan acknowledge regime asymmetry?",
        "Does it preserve necessary conflict or productive tension?"
      ],
      "fail_condition": "false_harmony_score >= 0.60 OR forced_alignment_score >= 0.60 OR party_erasure_score >= 0.60"
    },
    "operator_regime_integrity_gate": {
      "questions": [
        "Is an operator conflict being confused with a regime conflict?",
        "Is a computed label being used as a primitive cause?",
        "Does the rebase center specify whether it is operator-level, regime-level, dependency-level, or label-level?"
      ],
      "pass_condition": "operator_regime_conflation_score < 0.45 AND composite_label_collapse_score < 0.45"
    }
  },
  "candidate_branch_types": [
    "direct_preservation_branch",
    "operator_conflict_rebase_branch",
    "regime_conflict_rebase_branch",
    "operator_alignment_rebase_branch",
    "regime_alignment_rebase_branch",
    "dependency_rebase_branch",
    "complementarity_rebase_branch",
    "productive_tension_branch",
    "same_operator_different_regime_branch",
    "different_operator_same_regime_branch",
    "false_harmony_rejection_branch",
    "trust_repair_branch",
    "coalition_branch",
    "falsifier_branch"
  ],
  "output_schema": {
    "crem_packet": {
      "schema_version": "crem.parallax/1.3",
      "source_refs": {
        "prompt_ref": "string_or_null",
        "coupler_packet_ref": "string_or_null",
        "ontology_profile_refs": [],
        "dynamical_core_refs": [],
        "regime_field_refs": []
      },
      "selected_mode": "operator_conflict_rebase|regime_conflict_rebase|operator_alignment_rebase|regime_alignment_rebase|mixed_rebase|productive_tension_preservation",
      "party_graph": "object",
