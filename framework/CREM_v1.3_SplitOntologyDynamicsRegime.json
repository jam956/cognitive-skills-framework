      }
    },
    "context": {
      "type": "object",
      "required": false,
      "properties": {
        "depth_level": "integer_1_to_3",
        "mode": [
          "auto",
          "operator_conflict_rebase",
          "regime_conflict_rebase",
          "operator_alignment_rebase",
          "regime_alignment_rebase",
          "mixed_rebase",
          "productive_tension_preservation"
        ],
        "novelty_mode": [
          "bounded",
          "elevated",
          "max_discovery"
        ],
        "relationship_goal": [
          "none",
          "strengthen_relationship",
          "repair_trust",
          "build_coalition",
          "improve_coordination",
          "preserve_productive_tension",
          "find_common_ground",
          "synthesize_without_erasure"
        ],
        "require_citations_or_fact_check": "boolean",
        "handoff_target": [
          "direct_synthesis",
          "pspp",
          "memory",
          "outer_loop",
          "all"
        ],
        "max_candidate_invariants": "integer",
        "max_latent_axes": "integer",
        "max_candidate_systems": "integer",
        "max_party_count_soft": "integer"
      }
    }
  },
