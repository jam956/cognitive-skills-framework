    "anti_unbounded_discontinuity": {
      "anchor_suspension_requires_authorization": true,
      "hard_constraints_must_be_preserved": true,
      "user_goal_must_be_preserved": true,
      "falsifiers_required": true,
      "speculation_must_be_marked": true,
      "CEC_review_required_when_order_matters": true
