      "operators": [
        "anchor_suspension",
        "dependency_inversion",
        "new_anchor_induction",
        "logic_reconstitution"
      ]
    }
  },
  "discontinuous_reconstitution_protocol": {
    "description": "Bounded procedure for anchor suspension and replacement-anchor induction.",
    "allowed_only_when": [
      "unknown_pressure >= high_threshold",
      "anchor_suspicion >= high_threshold",
      "normal_transforms_failed_or_insufficient",
      "hard_constraints_preserved",
      "user_goal_preserved",
      "falsifiers_defined",
      "speculation_marked"
    ],
    "operators": [
      {
        "id": "DARE_ANCHOR_SUSPEND_001",
        "label": "anchor_suspension",
        "purpose": "Temporarily suspend the primary anchor while preserving observations, user goal, and hard constraints."
      },
      {
        "id": "DARE_DEP_INVERT_001",
        "label": "dependency_inversion",
        "purpose": "Test whether preserved dependencies are false, reversed, or emergent."
      },
      {
        "id": "DARE_BOUNDARY_DESTROY_001",
        "label": "boundary_destruction",
        "purpose": "Erase the assumed system boundary and reconstitute around observed interaction patterns."
      },
      {
        "id": "DARE_NEW_ANCHOR_001",
        "label": "new_anchor_induction",
        "purpose": "Induce replacement anchors from residual observations."
      },
      {
        "id": "DARE_RECONSTITUTE_001",
        "label": "logic_reconstitution",
        "purpose": "Rebuild coherent logic around the replacement anchor and report what old constraints survive."
      }
    ],
    "must_emit": [
      "old_anchor_failure_explanation",
      "preserved_observations",
      "preserved_hard_constraints",
      "replacement_anchor_candidates",
      "surviving_dependencies",
      "discarded_dependencies",
      "falsifiers",
      "speculation_status",
      "CEC_reconstitution_review_request_if_path_order_matters"
    ]
  },
