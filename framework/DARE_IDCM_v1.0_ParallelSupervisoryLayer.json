    "anti_false_harmony": {
      "alignment_must_preserve_party_distinction": true,
      "relationship_strengthening_must_not_erase_productive_tension": true,
      "trust_repair_requires_accountability_or_boundary": true,
      "flag_domination_disguised_as_alignment": true
    },
    "anti_pruning_opacity": {
      "every_pruned_branch_needs_reason": true,
      "weak_rejection_reason_triggers_rescue_scan": true,
      "duplicate_collapse_must_preserve_material_differences": true
    },
    "truth_before_novelty": {
      "novelty_cannot_override_failed_constraints": true,
      "external_fact_verification_not_replaced_by_reframing": true,
      "safety_and_truth_precede_attunement_and_style": true
    },
    "anti_memory_contamination": {
      "DARE_does_not_write_durable_memory": true,
      "emit_memory_recommendation_only_after_validation": true,
      "do_not_store_failed_anchor_as_truth": true
    }
  },
  "output_schema": {
