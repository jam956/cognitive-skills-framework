  "guards": {
    "anti_overintervention": {
      "do_not_intervene_when_risk_low": true,
      "prefer_targeted_rerun_over_full_pipeline_rerun": true,
      "prefer_operator_injection_over_anchor_suspension": true,
      "intervention_requires_expected_information_gain": true
