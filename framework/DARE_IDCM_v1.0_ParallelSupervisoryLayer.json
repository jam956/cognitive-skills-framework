        "selected_strategy": "allow_standard_route|targeted_rerun|operator_injection|branch_rescue|CREM_review|CEC_review|ETE_reexploration|PSPP_rescore|adversarial_verification|anchor_suspension|hold_for_arbiter_caveat",
        "reason": "array",
        "expected_information_gain": "number",
        "cost_risk_note": "string"
      },
      "correction_requests": [
        {
          "request_id": "string",
          "target_module": "KCE|CDP|PrismCoupler|CTR|ETE|CREM|PSPP_Lite|CEC|Arbiter",
          "request_type": "rerun|operator_injection|branch_rescue|review|rescore|reconstitution_review|caveat",
          "payload": "object",
          "priority": "low|moderate|high|critical"
        }
      ],
      "rescued_branches": [
        {
          "branch_id": "string",
          "source_module": "string",
          "original_rejection_reason": "string",
          "rescue_reason": "string",
          "required_repair": "array",
          "rescue_priority": "number",
          "send_to": "ETE|PSPP_Lite|CEC|CREM|Arbiter"
        }
      ],
      "operator_injection_requests": [
        {
          "request_id": "string",
          "target": "CTR",
