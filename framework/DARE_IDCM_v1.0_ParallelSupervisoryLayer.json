          "expected_information_gain": "number",
          "verification_requirements": "array"
        }
      ],
      "reconstitution_packet": {
        "status": "not_applicable|requested|authorized|emitted|rejected",
        "old_anchor_failure_explanation": "string_or_null",
        "preserved_observations": "array",
        "preserved_hard_constraints": "array",
        "replacement_anchor_candidates": "array",
        "surviving_dependencies": "array",
        "discarded_dependencies": "array",
        "falsifiers": "array",
        "speculation_status": "none|bounded_speculative|requires_validation",
        "CEC_review_required": "boolean"
      },
      "approval_decision": {
        "decision": "approve_standard_synthesis|approve_with_caveats|hold_for_rerun|hold_for_CREM|hold_for_CEC|hold_for_operator_injection|hold_for_reconstitution|reject_current_selection",
        "reason": "array",
        "required_before_synthesis": "array",
        "caveats_for_arbiter": "array"
      },
      "handoff": {
        "to_CTR": "operator_injection_requests",
        "to_ETE": "rescued_branches_or_reexploration_request",
        "to_CREM": "relationship_or_conflict_review_request",
        "to_PSPP": "rescore_or_branch_rescue_request",
        "to_CEC": "path_or_reconstitution_review_request",
        "to_Arbiter": "approval_decision_and_caveats"
      },
      "trace": {
        "operators_used": "array",
        "decision_notes": "array",
        "risk_notes": "array"
      }
    }
  },
  "routing_policy": {
    "default": "watch_and_audit",
    "rules": [
      {
        "condition": "all_risk_scores_low AND artifact_integrity_good",
        "action": "approve_standard_synthesis"
      },
      {
        "condition": "artifact_integrity_missing_material_artifacts",
        "action": "hold_for_artifact_request_or_arbiter_caveat"
      },
      {
        "condition": "operator_gap_suspicion >= operator_gap_suspicion_high",
        "action": "request_CTR_operator_injection"
      },
      {
        "condition": "high_pruning_loss OR rejected_branch_rescue_priority >= branch_rescue_min_priority",
        "action": "rescue_pruned_branch_or_request_PSPP_rescore"
      },
      {
        "condition": "false_harmony_suspicion >= false_harmony_high OR forced_alignment_suspicion >= forced_alignment_high",
        "action": "request_CREM_relationship_safety_review"
      },
      {
        "condition": "fragility_score >= fragility_high OR high_coherence_low_robustness",
        "action": "request_adversarial_verification_or_CTR_negation_operator"
      },
      {
        "condition": "CEC_reports_reconstitution_required",
        "action": "request_DARE_reconstitution_packet"
      },
      {
        "condition": "unknown_pressure >= unknown_pressure_high AND anchor_suspicion >= anchor_suspicion_high",
        "action": "request_targeted_repairs_then_consider_anchor_suspension"
      },
      {
        "condition": "unknown_pressure >= unknown_pressure_critical AND allow_anchor_suspension == true",
        "action": "authorize_bounded_discontinuous_reconstitution"
      }
    ]
  },
  "canonical_packet_compatibility": {
    "legacy_counteragent_fields": [
      "audit_report",
      "rescued_branches",
      "operator_injection_requests",
      "approval_decision"
    ],
    "new_fields": [
      "unknown_pressure_report",
      "relationship_safety_report",
      "reconstitution_packet",
      "artifact_integrity_report"
    ],
    "compatibility_note": "Older orchestrators may consume audit_report and approval_decision. New stack orchestrators should consume unknown_pressure_report, correction_requests, and reconstitution_packet."
  },
