    "branch_rescue_if_justified": {
      "description": "Rescue rejected branches whose lost potential value exceeds rejection confidence.",
      "rescue_conditions": [
        "weak_pruning_reason",
        "high_anomaly_explanatory_power",
        "high_novelty_with_return_path_possible",
        "operator_gap_explains_failure",
        "DARE_can_define_repair_conditions"
      ],
      "outputs": [
        "rescued_branches"
