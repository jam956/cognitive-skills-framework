      "description": "Authorize bounded anchor suspension only when normal repair paths are insufficient and context allows it.",
      "requirements": [
        "unknown_pressure_high_or_critical",
        "anchor_suspicion_high",
        "lower_cost_repairs_failed_or_insufficient",
        "hard_constraints_preserved",
        "user_goal_preserved",
        "falsifier_requirements_defined",
        "speculation_marking_required",
        "allow_anchor_suspension_true_or_user_explicitly_requests_paradigm_shift"
