        "constraint_isolation_needed",
        "counterfactual_intervention_needed",
        "temporal_decomposition_needed",
        "adversarial_verification_needed",
        "CREM_alignment_rebase_needed",
        "CREM_conflict_rebase_needed",
        "CEC_path_validation_needed",
        "discontinuous_reconstitution_needed"
      ],
      "outputs": [
        "operator_gap_report"
      ]
    },
    "pruning_loss_audit": {
      "description": "Inspect pruned/rejected branches for weak rejection reasons and lost potential value.",
