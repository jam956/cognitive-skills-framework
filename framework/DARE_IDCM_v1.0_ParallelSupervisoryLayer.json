        "request_targeted_rerun",
        "request_CTR_operator_injection",
        "rescue_pruned_branch",
        "request_CREM_review",
        "request_CEC_review",
        "request_ETE_reexploration",
        "request_PSPP_rescore",
        "request_adversarial_verification",
        "authorize_anchor_suspension",
        "hold_for_arbiter_caveat"
      ],
      "outputs": [
        "correction_strategy"
      ]
