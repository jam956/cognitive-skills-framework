  "guards": {
    "split_layer_integrity_guard": {
      "computed_labels_not_primitive": true,
      "regime_terms_not_core_operators": true,
      "ontology_not_action_without_coupler_binding": true,
      "same_operator_different_regime_check_required_when_CREM_like": true
    },
    "return_path_guard": {
      "normal_transforms_require_return_path": true,
      "DARE_required_for_unreturnable_discontinuity": true,
      "CEC_review_required_for_order_sensitive_reconstitution": true
    },
    "anti_decorative_metaphor_guard": {
      "metaphor_must_improve_candidate_system_or_uncertainty": true,
      "decorative_projection_pruned": true
    },
    "ECE_safety_guard": {
      "honor_safety_gate_strength": true,
      "do_not_promote_manipulative_attunement_branch": true,
      "false_harmony_unresolved_blocks_relationship_branch": true
