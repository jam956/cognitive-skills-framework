    "handoff_emit"
  ],
  "stage_summaries": {
    "computed_label_decomposition_pass": {
      "purpose": "Execute CTR label-decomposition transforms so labels do not serve as primitive causes.",
      "operators_consumed": [
        "CTR_LABEL_DECOMP_001",
        "CTR_LABEL_ALIAS_001",
        "CTR_LABEL_RENAME_001",
        "CTR_NEG_LABEL_001"
      ],
      "outputs": [
        "label_decomposition_packets",
        "label_support_scores",
        "alternate_label_candidates"
      ]
    },
    "operator_projection_pass": {
      "purpose": "Project primitive operator motifs across selected ontologies and actors.",
      "projection_units": [
        "signal_detect_interpret",
        "detect_interpret_select",
        "constrain_gate_stabilize",
        "explore_select_execute_encode",
        "disrupt_stabilize_recovery",
        "coordinate_signal_trust",
        "anticipate_select_execute",
        "adapt_stabilize_feedback",
        "gate_execute_threshold"
      ]
    },
    "regime_projection_pass": {
      "purpose": "Project regime motifs across candidate systems while preserving operator vectors when possible.",
      "projection_units": [
        "trust_shift",
        "legitimacy_shift",
        "scarcity_to_abundance",
        "crisis_to_repair",
        "high_noise_to_low_noise",
        "hierarchy_to_distributed_authority",
        "reversible_to_irreversible",
        "open_boundary_to_gated_boundary",
        "underconstrained_to_overconstrained",
        "stable_to_bifurcating"
      ]
    },
    "operator_regime_mismatch_pass": {
      "purpose": "Explore mismatches where a valid operator vector becomes risky or changes meaning under a regime.",
      "mismatch_patterns": [
        "stabilize_under_growth_regime",
        "explore_under_emergency_regime",
        "constrain_under_trust_repair_regime",
        "signal_under_high_noise_regime",
        "coordinate_under_low_trust_regime",
        "select_under_high_uncertainty_regime",
        "adapt_under_high_irreversibility_regime"
      ]
    },
    "invariant_extraction": {
      "target_invariant_types": [
        "feedback_loop",
        "cooperation_breakdown",
        "signal_noise",
        "phase_lock_instability",
        "resource_competition",
        "role_conflict",
        "threshold_transition",
        "redundancy_or_fragility",
        "selection_pressure",
        "communication_distortion",
        "gating_misalignment",
        "rectification_window",
        "constraint_binding",
        "wrong_abstraction_level",
        "causal_mediator",
        "temporal_phase_boundary",
        "falsifier_condition",
        "same_operator_different_regime",
        "different_operator_same_regime",
        "regime_asymmetry",
        "computed_label_instability",
        "operator_regime_mismatch"
      ]
    }
  },
