{
  "module_name": "Exploration and Transform Engine",
  "short_name": "ETE",
  "version": "v1.1.0",
  "status": "conceptual_executable_spec",
  "revision_kind": "split_ontology_dynamical_core_regime_execution_layer",
  "supersedes": "ETE_ExplorationTransformEngine_v1.0",
  "purpose": "Execute bounded exploration and transform plans produced by CTR v2.1 using the split architecture: 19D Ontologic Prism, Dynamical Prism v0.2 Reduced Core, Regime Field v0.1, Prism Coupler v1.5, CREM v1.3, KCE v2.3, and ECE v0.3.",
  "core_doctrine": [
    "CTR is the transform vocabulary and router; ETE is the transform executor.",
    "Project primitive operators separately from regimes.",
    "Decompose computed labels before using them as explanatory centers.",
    "Prefer operator-level and regime-level projection before whole-domain metaphorical projection.",
    "Promote candidate systems, not merely clever framings.",
    "Preserve return paths unless DARE explicitly authorizes discontinuity.",
    "Prune by validity, returnability, information gain, branch distinctness, and split-layer integrity.",
    "Emit rejected-branch artifacts for DARE inspection.",
    "When apparent dynamical conflict is same-operator/different-regime, route or hand off to CREM v1.3."
  ],
  "registry_refs": {
    "KCE": "KCE_Parallax_v2.3_SplitLayerAnchor.json",
    "CDP": "CDP_Parallax_v1.2_BoundedDomainSpace.json",
    "DynamicalPrism": "Dynamical_Prism_v1.2_ReducedCore.json",
    "RegimeField": "Regime_Field_v0.1.json",
    "PrismCoupler": "Prism_Coupler_v1.5_OntologyDynamicsRegime.json",
    "CTR": "CTR_Parallax_v2.1_SplitTransformRegistry.json",
    "CREM": "CREM_v1.3_SplitOntologyDynamicsRegime.json",
    "ECE": "ECE_v0.3_optional_affect_reward_regulation",
    "PSPP_Lite": "PSPP_v5.0_CandidateSystemComparator.json",
    "CEC": "CEC_Parallax_v1.1_ConditionalPathValidator.json",
    "DARE_IDCM": "DARE_IDCM_v1.0_ParallelSupervisoryLayer.json"
  },
  "responsibility_boundary": {
    "owns": [
      "exploration_orchestration",
      "CTR_plan_execution",
      "operator_level_projection",
      "regime_level_projection",
      "computed_label_decomposition_execution",
      "split_layer_diagnostic_rotation",
      "transform_view_generation",
      "bundle_projection",
      "candidate_invariant_extraction",
      "operator_regime_mismatch_exploration",
      "same_operator_different_regime_branch_generation",
      "different_operator_same_regime_branch_generation",
      "projection_validity_scoring",
      "return_path_tracking",
      "projection_ledger_update",
      "candidate_system_branch_emission",
      "rejected_branch_artifact_emission",
      "CREM_handoff_request_when_relationship_rebase_needed"
    ],
    "does_not_own": [
      "operator_registry_definition",
      "primary_anchor_extraction",
      "domain_axis_definition",
      "primitive_dynamical_operator_definition",
      "regime_axis_definition",
      "actor_binding_final",
      "branch_final_selection",
      "ordered_path_validation",
      "relationship_rebase_execution",
      "final_answer_synthesis",
      "external_fact_verification",
      "durable_memory_write_execution"
    ]
  },
  "placement": {
    "pipeline_stage": "exploration_transform_execution",
    "runs_after": [
      "KCE_Parallax_v2.3",
      "CDP_Parallax_v1.2",
      "Dynamical_Prism_v0.2",
      "Regime_Field_v0.1",
      "Prism_Coupler_v1.5",
      "CTR_v2.1_transform_plan_request",
      "ECE_v0.3_dial_nudges_optional"
    ],
    "runs_before": [
      "PSPP_lite_candidate_system_comparison",
      "CREM_v1.3_when_relationship_rebase_needed",
      "CEC_when_sequence_validity_needed",
      "DARE_IDCM_audit",
      "final_arbiter"
    ],
    "recommended_mode": "bounded_iterative_split_layer_exploration"
  },
