{
  "module_name": "Dynamical Prism",
  "short_name": "Dynamical_Prism",
  "version": "v0.2.0_reduced_core",
  "status": "conceptual_refactor",
  "supersedes": "Dynamical_Prism_Preliminary_v0.1",
  "purpose": "Describe what systems do using a reduced primitive dynamical core separated from regime constraints and computed behavior labels.",
  "core_doctrine": [
    "The Dynamical Core describes primitive process-verbs.",
    "The Regime Field describes constraints, phase-state, context, and operating conditions.",
    "Composite behavior labels are computed from ontology + actor role + dynamical core + regime field.",
    "Do not treat control, healing, growth, conflict, governance, collapse, or creation as primitive operators.",
    "Do not treat crisis, scarcity, legitimacy, trust, ritual, market, homeostasis, or emergency as primitive operators.",
    "The same operator vector may produce different behavior labels under different regimes.",
    "Operator-regime mismatch is a first-class diagnostic target."
  ],
  "layer_model": {
    "ontology_layer": "What kind of thing/domain is involved. Owned by CDP.",
    "actor_role_layer": "Who or what carries, receives, gates, reflects, or transforms operator mass. Owned by Coupler.",
    "dynamical_core": "Reduced primitive operator vector describing what the system is doing.",
    "regime_field": "Constraint/context/phase field describing under what conditions the operator vector acts.",
    "computed_behavior_label": "Human-readable derived label for the bound pattern."
  },
