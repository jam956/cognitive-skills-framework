  "operators": {
    "signal": {
      "cluster": "information_representation",
      "definition": "Emit, project, or propagate information, state, force, or influence into a system."
    },
    "detect": {
      "cluster": "information_representation",
      "definition": "Sense, register, receive, measure, or notice incoming information, state, or perturbation."
    },
    "interpret": {
      "cluster": "information_representation",
      "definition": "Assign meaning, classify, decode, infer, or contextualize what has been detected or signaled."
    },
    "encode": {
      "cluster": "information_representation",
      "definition": "Form, structure, compress, or transform representation so it can persist, transmit, store, or operate downstream."
    },
    "execute": {
      "cluster": "intervention_action",
      "definition": "Cause a concrete effect, state change, or action in a system."
    },
    "disrupt": {
      "cluster": "intervention_action",
      "definition": "Break continuity, degrade structure, interrupt flow, destabilize pattern, or fracture an existing order."
    },
    "coordinate": {
      "cluster": "intervention_action",
      "definition": "Synchronize, align, organize, or orchestrate multiple elements toward compatible action."
    },
    "constrain": {
      "cluster": "boundary_control",
      "definition": "Limit possible states, actions, transitions, or interpretations available to a system."
    },
    "gate": {
      "cluster": "boundary_control",
      "definition": "Permit, deny, filter, or condition passage across a boundary, threshold, channel, or interface."
    },
    "stabilize": {
      "cluster": "boundary_control",
      "definition": "Maintain, restore, dampen, or preserve dynamic equilibrium against perturbation."
    },
    "explore": {
      "cluster": "adaptive_search",
      "definition": "Search possibility space, sample alternatives, expand options, or test reachable states."
    },
    "select": {
      "cluster": "adaptive_search",
      "definition": "Choose, filter, prefer, rank, or collapse alternatives according to criteria."
    },
    "adapt": {
      "cluster": "adaptive_search",
      "definition": "Reconfigure internal state, behavior, or structure in response to environmental change or feedback."
    },
    "anticipate": {
      "cluster": "adaptive_search",
      "definition": "Model, forecast, prepare for, or weight possible future states before they arrive."
    }
  },
